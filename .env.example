# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/jwt-auth-db

# Secret used to sign JWTs (use a long random string in production)
JWT_SECRET=replace-with-a-long-random-string

# Secret used by express-session to sign the session ID cookie
SESSION_SECRET=replace-with-a-different-long-random-string

# Credentials used by seed.js to create the initial admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
