<% layout('base') %>

<style>
  .form-input {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
  }
</style>

<div class="flex flex-col min-h-screen">
  <main class="flex-grow flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="w-full max-w-md space-y-8">
      <div>
        <h2 class="mt-6 text-center text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Edit User</h2>
        <p class="mt-2 text-center text-sm text-gray-600 dark:text-gray-400">Update user account information</p>
      </div>

      <form action="/admin/users/<%= user._id %>?_method=PUT" class="mt-8 space-y-6" method="POST">
        <div class="space-y-4 rounded-lg">
          <div>
            <label class="sr-only" for="name">Full name</label>
            <input id="name" name="name" type="text" required value="<%= user.name %>" placeholder="Full name" class="form-input w-full px-4 py-3 border border-gray-300 dark:border-gray-700 rounded-lg bg-background-light dark:bg-background-dark placeholder-gray-500 dark:placeholder-gray-400 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" />
          </div>

          <div>
            <label class="sr-only" for="email">Email address</label>
            <input id="email" name="email" type="email" required value="<%= user.email %>" placeholder="Email address" class="form-input w-full px-4 py-3 border border-gray-300 dark:border-gray-700 rounded-lg bg-background-light dark:bg-background-dark placeholder-gray-500 dark:placeholder-gray-400 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Role</label>
            <select name="role" class="form-input w-full px-4 py-3 border border-gray-300 dark:border-gray-700 rounded-lg bg-background-light dark:bg-background-dark text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary">
              <option value="user" <%= user.role === 'user' ? 'selected' : '' %>>User</option>
              <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Admin</option>
            </select>
          </div>

          <div class="pt-4">
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">Leave password fields blank to keep current password</p>
            <input autocomplete="new-password" id="newPassword" name="newPassword" placeholder="New password (optional)" type="password" class="form-input w-full px-4 py-3 border border-gray-300 dark:border-gray-700 rounded-lg bg-background-light dark:bg-background-dark placeholder-gray-500 dark:placeholder-gray-400 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" minlength="6" />
          </div>

          <div>
            <input autocomplete="new-password" id="confirmNewPassword" name="confirmNewPassword" placeholder="Confirm new password (optional)" type="password" class="form-input w-full px-4 py-3 border border-gray-300 dark:border-gray-700 rounded-lg bg-background-light dark:bg-background-dark placeholder-gray-500 dark:placeholder-gray-400 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" minlength="6" />
          </div>
        </div>

        <div class="flex gap-3">
          <button type="submit" class="group relative flex flex-1 justify-center rounded-lg border border-transparent bg-primary py-3 px-4 text-sm font-semibold text-white hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-background-light dark:focus:ring-offset-background-dark">Save Changes</button>
          <a href="/admin/dashboard" class="group relative flex flex-1 justify-center rounded-lg border border-gray-300 dark:border-gray-700 bg-transparent py-3 px-4 text-sm font-semibold text-gray-900 dark:text-white hover:bg-gray-100 dark:hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2 focus:ring-offset-background-light dark:focus:ring-offset-background-dark">Cancel</a>
        </div>
      </form>
    </div>
  </main>
</div>
