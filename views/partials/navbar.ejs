<header class="border-b border-gray-200 dark:border-gray-700">
  <div class="container mx-auto flex items-center justify-between p-4">
    <div class="flex items-center gap-2">
      <svg
        class="h-8 w-8 text-primary"
        fill="none"
        viewBox="0 0 48 48"
        xmlns="http://www.w3.org/2000/svg">
        <g clip-path="url(#clip0_6_319)">
          <path
            d="M8.57829 8.57829C5.52816 11.6284 3.451 15.5145 2.60947 19.7452C1.76794 23.9758 2.19984 28.361 3.85056 32.3462C5.50128 36.3314 8.29667 39.7376 11.8832 42.134C15.4698 44.5305 19.6865 45.8096 24 45.8096C28.3135 45.8096 32.5302 44.5305 36.1168 42.134C39.7033 39.7375 42.4987 36.3314 44.1494 32.3462C45.8002 28.361 46.2321 23.9758 45.3905 19.7452C44.549 15.5145 42.4718 11.6284 39.4217 8.57829L24 24L8.57829 8.57829Z"
            fill="currentColor"></path>
        </g>
        <defs>
          <clipPath id="clip0_6_319">
            <rect fill="white" height="48" width="48"></rect>
          </clipPath>
        </defs>
      </svg>
      <a href="/" class="text-xl font-bold hover:text-primary">JWT Auth</a>
    </div>
    <nav class="flex items-center gap-6">
      <% if (currentUser) { %>
      <a
        class="text-sm font-medium hover:text-primary hidden md:inline"
        href="/"
        >Dashboard</a
      >
      <a
        class="text-sm font-medium hover:text-primary hidden md:inline"
        href="/profile"
        >Profile</a
      >
      <% if (currentUser.role === 'admin') { %>
      <a
        class="text-sm font-medium hover:text-primary hidden md:inline"
        href="/admin/dashboard"
        >Admin Panel</a
      >
      <% } %>
      <a
        class="rounded bg-red-500 px-4 py-2 text-sm font-bold text-white hover:bg-red-600"
        href="/logout">
        <i class="fas fa-sign-out-alt me-1"></i>Logout
      </a>
      <% } else { %>
      <a class="text-sm font-medium hover:text-primary" href="/login">Login</a>
      <a
        class="rounded bg-primary px-4 py-2 text-sm font-bold text-white hover:bg-opacity-90"
        href="/register">
        Sign Up
      </a>
      <% } %>
    </nav>
  </div>
</header>
