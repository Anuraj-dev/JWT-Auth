<% layout('base') %>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <!-- Welcome Card -->
      <div class="card shadow-lg border-0 mb-4">
        <div class="card-body p-5">
          <div class="text-center mb-4">
            <i
              class="fas fa-tachometer-alt text-primary"
              style="font-size: 3rem"></i>
            <h1 class="mt-3 mb-2">Welcome to Your Dashboard</h1>
            <% if (currentUser) { %>
            <p class="text-muted lead">
              Hello, <%= currentUser.email %>! You're logged in as
              <strong><%= currentUser.role %></strong>.
            </p>
            <% } %>
          </div>

          <div class="row text-center mt-5">
            <div class="col-md-4 mb-4">
              <div class="p-4 bg-light rounded">
                <i
                  class="fas fa-user-circle text-primary mb-3"
                  style="font-size: 2.5rem"></i>
                <h5>Profile</h5>
                <p class="text-muted small">
                  View and manage your profile information
                </p>
                <a href="/profile" class="btn btn-primary btn-sm"
                  >Go to Profile</a
                >
              </div>
            </div>
            <div class="col-md-4 mb-4">
              <div class="p-4 bg-light rounded">
                <i
                  class="fas fa-shield-alt text-success mb-3"
                  style="font-size: 2.5rem"></i>
                <h5>Security</h5>
                <p class="text-muted small">Your account is secured with JWT</p>
                <button class="btn btn-success btn-sm" disabled>
                  Protected
                </button>
              </div>
            </div>
            <div class="col-md-4 mb-4">
              <div class="p-4 bg-light rounded">
                <i
                  class="fas fa-cog text-warning mb-3"
                  style="font-size: 2.5rem"></i>
                <h5>Settings</h5>
                <p class="text-muted small">Manage your account settings</p>
                <button class="btn btn-warning btn-sm">Coming Soon</button>
              </div>
            </div>
          </div>

          <% if (currentUser && currentUser.role === 'admin') { %>
          <div class="alert alert-info mt-4" role="alert">
            <i class="fas fa-info-circle me-2"></i>
            <strong>Admin Access:</strong> You have administrator privileges.
            Visit the
            <a href="/admin/dashboard" class="alert-link">Admin Panel</a> for
            additional features.
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
