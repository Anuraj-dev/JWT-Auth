<% layout('base') %>

<div class="min-h-full py-8 px-4 flex items-center justify-center">
  <div
    class="w-full max-w-md bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-6">
    <div class="text-center mb-6">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
        Edit Your Profile
      </h1>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
        Update your account information
      </p>
    </div>

    <form action="/profile/edit?_method=PUT" class="space-y-4" method="POST">
      <div>
        <label
          class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
          for="name">
          Full Name
        </label>
        <input
          class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-colors"
          id="name"
          name="name"
          placeholder="John Doe"
          required
          type="text"
          value="<%= user.name %>" />
      </div>

      <div>
        <label
          class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
          for="email">
          Email Address
        </label>
        <input
          autocomplete="email"
          class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-colors"
          id="email"
          name="email"
          placeholder="you@example.com"
          required
          type="email"
          value="<%= user.email %>" />
      </div>

      <div class="pt-2 border-t border-gray-200 dark:border-gray-700">
        <p class="text-xs text-gray-500 dark:text-gray-400 mb-3">
          <i class="fas fa-info-circle mr-1"></i>
          Leave password fields blank to keep your current password
        </p>

        <div class="space-y-3">
          <div>
            <label
              class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
              for="currentPassword">
              Current Password
            </label>
            <input
              autocomplete="current-password"
              class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-colors"
              id="currentPassword"
              name="currentPassword"
              placeholder="Current password"
              type="password" />
          </div>

          <div>
            <label
              class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
              for="newPassword">
              New Password
            </label>
            <input
              autocomplete="new-password"
              class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-colors"
              id="newPassword"
              name="newPassword"
              placeholder="New password (min. 6 characters)"
              minlength="6"
              type="password" />
          </div>

          <div>
            <label
              class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
              for="confirmNewPassword">
              Confirm New Password
            </label>
            <input
              autocomplete="new-password"
              class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-colors"
              id="confirmNewPassword"
              name="confirmNewPassword"
              placeholder="Confirm new password"
              minlength="6"
              type="password" />
          </div>
        </div>
      </div>

      <div class="flex gap-2 pt-2">
        <button
          class="flex-1 py-2 px-4 text-sm font-semibold text-white bg-primary rounded-md hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 transition-colors duration-200"
          type="submit">
          Save Changes
        </button>
        <a
          href="/profile"
          class="flex-1 py-2 px-4 text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-md text-center hover:bg-gray-50 dark:hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2 transition-colors duration-200">
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>
