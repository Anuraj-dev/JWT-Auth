<% layout('base') %>

<style>
  .form-input {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
  }
</style>

<div class="flex flex-col min-h-screen">
  <main
    class="flex-grow flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="w-full max-w-md space-y-8">
      <div>
        <h2
          class="mt-6 text-center text-3xl font-bold tracking-tight text-gray-900 dark:text-white">
          Create your account
        </h2>
      </div>
      <form action="/register" class="mt-8 space-y-6" method="POST">
        <div class="space-y-4 rounded-lg">
          <div>
            <label class="sr-only" for="name">Full name</label>
            <input
              class="form-input w-full px-4 py-3 border border-gray-300 dark:border-gray-700 rounded-lg bg-background-light dark:bg-background-dark placeholder-gray-500 dark:placeholder-gray-400 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary"
              id="name"
              name="name"
              placeholder="Full name"
              required
              type="text" />
          </div>
          <div>
            <label class="sr-only" for="email">Email address</label>
            <input
              autocomplete="email"
              class="form-input w-full px-4 py-3 border border-gray-300 dark:border-gray-700 rounded-lg bg-background-light dark:bg-background-dark placeholder-gray-500 dark:placeholder-gray-400 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary"
              id="email"
              name="email"
              placeholder="Email address"
              required
              type="email" />
          </div>
          <div>
            <label class="sr-only" for="password">Password</label>
            <input
              autocomplete="new-password"
              class="form-input w-full px-4 py-3 border border-gray-300 dark:border-gray-700 rounded-lg bg-background-light dark:bg-background-dark placeholder-gray-500 dark:placeholder-gray-400 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary"
              id="password"
              name="password"
              placeholder="Password"
              required
              minlength="6"
              type="password" />
          </div>
          <div>
            <label class="sr-only" for="confirmPassword"
              >Confirm password</label
            >
            <input
              autocomplete="new-password"
              class="form-input w-full px-4 py-3 border border-gray-300 dark:border-gray-700 rounded-lg bg-background-light dark:bg-background-dark placeholder-gray-500 dark:placeholder-gray-400 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary"
              id="confirmPassword"
              name="confirmPassword"
              placeholder="Confirm password"
              required
              minlength="6"
              type="password" />
          </div>
        </div>
        <div>
          <button
            class="group relative flex w-full justify-center rounded-lg border border-transparent bg-primary py-3 px-4 text-sm font-semibold text-white hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-background-light dark:focus:ring-offset-background-dark"
            type="submit">
            Create Account
          </button>
        </div>
      </form>
      <p class="mt-4 text-center text-sm text-gray-600 dark:text-gray-400">
        By creating an account, you agree to our
        <a class="font-medium text-primary hover:text-primary/90" href="#"
          >Terms of Service</a
        >
        and
        <a class="font-medium text-primary hover:text-primary/90" href="#"
          >Privacy Policy</a
        >.
      </p>
    </div>
  </main>
</div>
