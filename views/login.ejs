<% layout('base') %>

<div class="h-full flex items-center justify-center px-4">
  <div
    class="w-full max-w-md space-y-6 rounded-xl bg-background-light p-6 shadow-lg dark:bg-background-dark/50">
    <div class="text-center">
      <h2 class="text-3xl font-bold tracking-tight">Welcome Back</h2>
      <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
        Sign in to continue to your account.
      </p>
    </div>
    <form class="space-y-5" action="/login" method="POST">
      <div>
        <label class="block text-sm font-medium" for="email">Email</label>
        <div class="mt-1">
          <input
            autocomplete="email"
            class="w-full rounded border border-gray-300 bg-background-light p-3 placeholder-gray-400 focus:border-primary focus:ring-primary dark:border-gray-600 dark:bg-background-dark dark:focus:border-primary"
            id="email"
            name="email"
            placeholder="Enter your email"
            required
            type="email" />
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium" for="password">Password</label>
        <div class="mt-1">
          <input
            autocomplete="current-password"
            class="w-full rounded border border-gray-300 bg-background-light p-3 placeholder-gray-400 focus:border-primary focus:ring-primary dark:border-gray-600 dark:bg-background-dark dark:focus:border-primary"
            id="password"
            name="password"
            placeholder="Enter your password"
            required
            type="password" />
        </div>
      </div>
      <div>
        <button
          class="w-full rounded bg-primary px-4 py-3 text-sm font-bold text-white hover:bg-opacity-90"
          type="submit">
          Login
        </button>
      </div>
    </form>
    <p class="text-center text-sm text-gray-600 dark:text-gray-400">
      Don't have an account?
      <a class="font-medium text-primary hover:text-opacity-80" href="/register"
        >Sign up</a
      >
    </p>
  </div>
</div>
