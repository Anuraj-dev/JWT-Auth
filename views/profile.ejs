<% layout('base') %>

<div class="profile-container">
  <!-- Banner Section -->
  <div class="profile-banner">
    <div class="container py-5">
      <h1 class="text-white">Profile</h1>
    </div>
  </div>

  <!-- Profile Content -->
  <div class="container mt-5">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card shadow-lg border-0">
          <div class="card-body p-5">
            <!-- Profile Picture -->
            <div class="text-center mb-4" style="margin-top: -80px">
              <div class="profile-picture-wrapper">
                <img
                  src="https://ui-avatars.com/api/?name=<%= user.name %>&size=150&background=6366f1&color=fff&bold=true"
                  alt="Profile Picture"
                  class="profile-picture" />
              </div>
            </div>

            <!-- User Info -->
            <div class="text-center mb-4">
              <h2 class="mb-2"><%= user.name %></h2>
              <p class="text-muted mb-3">
                <i class="fas fa-envelope me-2"></i><%= user.email %>
              </p>
              <span class="badge bg-primary px-3 py-2">
                <i class="fas fa-user-tag me-1"></i>
                <%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %>
              </span>
            </div>

            <!-- Profile Details -->
            <div class="profile-details mt-5">
              <h4 class="mb-4">Account Information</h4>
              <div class="row g-3">
                <div class="col-md-6">
                  <div class="detail-item">
                    <label class="text-muted small">User ID</label>
                    <p class="mb-0 fw-semibold"><%= user.id %></p>
                  </div>
                </div>
                <div class="col-md-6">
                  <div class="detail-item">
                    <label class="text-muted small">Account Type</label>
                    <p class="mb-0 fw-semibold"><%= user.role %></p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex gap-3 mt-5 justify-content-center">
              <button class="btn btn-outline-primary">
                <i class="fas fa-edit me-2"></i>Edit Page
              </button>
              <a href="/logout" class="btn btn-danger">
                <i class="fas fa-sign-out-alt me-2"></i>Logout
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
