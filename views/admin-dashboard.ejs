<% layout('base') %>

<div class="container mx-auto px-4 sm:px-6 py-6 max-w-6xl min-h-full">
  <div class="flex items-center justify-between mb-5">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
        User Management
      </h1>
      <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
        Manage user accounts and permissions
      </p>
    </div>
    <a
      href="/admin/users/new"
      class="flex items-center gap-2 px-4 py-2 text-sm font-semibold bg-primary text-white rounded-md hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 transition-colors duration-200">
      <i class="fas fa-user-plus text-xs"></i>
      Add User
    </a>
  </div>

  <div
    class="bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden border border-gray-200 dark:border-gray-700">
    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left">
        <thead
          class="text-xs text-gray-600 dark:text-gray-400 uppercase bg-gray-50 dark:bg-gray-900/50 border-b border-gray-200 dark:border-gray-700">
          <tr>
            <th class="px-4 py-3 font-semibold">User</th>
            <th class="px-4 py-3 font-semibold">Role</th>
            <th class="px-4 py-3 text-right font-semibold">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
          <% if (users && users.length > 0) { %> <% users.forEach(function(u) {
          %>
          <tr
            class="hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors duration-150">
            <td class="px-4 py-3">
              <div>
                <div class="text-sm font-medium text-gray-900 dark:text-white">
                  <%= u.name %>
                </div>
                <div class="text-xs text-gray-500 dark:text-gray-400">
                  <%= u.email %>
                </div>
              </div>
            </td>
            <td class="px-4 py-3">
              <span
                class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-primary/10 text-primary">
                <%= u.role.charAt(0).toUpperCase() + u.role.slice(1) %>
              </span>
            </td>
            <td class="px-4 py-3 text-right">
              <div class="flex items-center justify-end gap-3">
                <% if (u.role !== 'admin') { %>
                <a
                  href="/admin/users/<%= u._id %>/edit"
                  class="text-sm font-medium text-primary hover:text-blue-600 transition-colors">
                  Edit
                </a>
                <form
                  action="/admin/users/<%= u._id %>?_method=DELETE"
                  method="POST"
                  class="inline"
                  onsubmit="return confirm('Are you sure you want to delete this user?');">
                  <button
                    type="submit"
                    class="text-sm font-medium text-red-600 dark:text-red-500 hover:text-red-700 dark:hover:text-red-400 transition-colors">
                    Delete
                  </button>
                </form>
                <% } else { %>
                <span class="text-xs text-gray-400 dark:text-gray-500 italic"
                  >Protected</span
                >
                <% } %>
              </div>
            </td>
          </tr>
          <% }) %> <% } else { %>
          <tr>
            <td
              class="px-4 py-8 text-center text-sm text-gray-500 dark:text-gray-400"
              colspan="3">
              <i
                class="fas fa-users text-gray-300 dark:text-gray-600 text-3xl mb-2"></i>
              <p>No users found</p>
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <div
      class="flex justify-between items-center px-4 py-3 bg-gray-50 dark:bg-gray-900/50 border-t border-gray-200 dark:border-gray-700">
      <span class="text-xs text-gray-600 dark:text-gray-400"
        >Showing
        <span class="font-medium"><%= users ? users.length : 0 %></span> <%=
        users && users.length === 1 ? 'user' : 'users' %></span
      >
      <div class="inline-flex -space-x-px">
        <button
          class="px-3 py-1.5 text-xs font-medium text-gray-600 dark:text-gray-400 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-l-md hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white transition-colors duration-200">
          Previous
        </button>
        <button
          class="px-3 py-1.5 text-xs font-medium text-gray-600 dark:text-gray-400 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-r-md hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white transition-colors duration-200">
          Next
        </button>
      </div>
    </div>
  </div>
</div>
