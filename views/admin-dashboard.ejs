<% layout('base') %>

<div class="min-h-screen">
  <main class="container mx-auto p-4 sm:p-6 lg:p-8">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
          User Management
        </h2>
        <p class="text-sm text-gray-500 dark:text-gray-400">
          Manage user accounts and permissions.
        </p>
      </div>
      <a
        href="/admin/users/new"
        class="flex items-center justify-center gap-2 h-10 px-4 text-sm font-medium text-white bg-primary rounded-lg hover:bg-primary/90">
        <i class="fas fa-user-plus"></i>
        Add User
      </a>
    </div>

    <div
      class="bg-white dark:bg-background-dark rounded-xl shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
          <thead
            class="text-xs text-gray-500 dark:text-gray-400 uppercase bg-gray-50 dark:bg-gray-800/50">
            <tr>
              <th class="px-6 py-3">User</th>
              <th class="px-6 py-3">Role</th>
              <th class="px-6 py-3 text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (users && users.length > 0) { %> <% users.forEach(function(u)
            { %>
            <tr
              class="border-b dark:border-gray-800 hover:bg-gray-50 dark:hover:bg-gray-800/30 transition-colors duration-200">
              <th
                class="flex items-center px-6 py-4 text-gray-900 dark:text-white whitespace-nowrap"
                scope="row">
                <div class="pl-3">
                  <div class="text-base font-semibold"><%= u.name %></div>
                  <div class="font-normal text-gray-500 dark:text-gray-400">
                    <%= u.email %>
                  </div>
                </div>
              </th>
              <td class="px-6 py-4">
                <%= u.role.charAt(0).toUpperCase() + u.role.slice(1) %>
              </td>
              <td class="px-6 py-4 text-right">
                <div class="flex items-center justify-end gap-4">
                  <% if (u.role !== 'admin') { %>
                  <a
                    href="/admin/users/<%= u._id %>/edit"
                    class="font-medium text-primary hover:underline">
                    Edit
                  </a>
                  <form
                    action="/admin/users/<%= u._id %>?_method=DELETE"
                    method="POST"
                    onsubmit="return confirm('Are you sure you want to delete this user?');">
                    <button
                      type="submit"
                      class="font-medium text-red-600 dark:text-red-500 hover:underline">
                      Delete
                    </button>
                  </form>
                  <% } else { %>
                  <span class="text-sm text-gray-400 dark:text-gray-500"
                    >Protected</span
                  >
                  <% } %>
                </div>
              </td>
            </tr>
            <% }) %> <% } else { %>
            <tr>
              <td class="p-6 text-center text-sm text-gray-500" colspan="3">
                No users found.
              </td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <div class="flex justify-between items-center px-6 py-4">
        <span class="text-sm text-gray-500 dark:text-gray-400"
          >Showing <%= users ? users.length : 0 %> users</span
        >
        <div class="inline-flex items-center -space-x-px">
          <button
            class="px-3 h-8 leading-tight text-gray-500 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-l-lg hover:bg-gray-100 hover:text-gray-700 dark:hover:bg-gray-700 dark:hover:text-white">
            Previous
          </button>
          <button
            class="px-3 h-8 leading-tight text-gray-500 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-r-lg hover:bg-gray-100 hover:text-gray-700 dark:hover:bg-gray-700 dark:hover:text-white">
            Next
          </button>
        </div>
      </div>
    </div>
  </main>
</div>
